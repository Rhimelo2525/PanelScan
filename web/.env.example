# Optional public backend base URL. Leave unset to use the typed local catalog fallback.
VITE_API_BASE_URL=http://localhost:4000/api

# Mapbox public token (pk.*) for the checkout delivery map picker - same
# value as the backend's MAPBOX_ACCESS_TOKEN (see backend/.env.example).
# Mapbox pk.* tokens are meant for client-side use, unlike the backend's
# other secret keys.
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token

# Optional public Google Client ID (if using direct Google Identity Services client-side)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

