# R8 rules for the release build (minified). AGP passes every file in
# src/main/keepRules to R8. Libraries that ship their own rules (OkHttp, Room,
# kotlinx.serialization, Coil) need nothing here.

# AR measurement and 3D: Filament, SceneView and ARCore reach their Java classes
# from native code (JNI), which R8 cannot see.
-keep class com.google.android.filament.** { *; }
-keep class io.github.sceneview.** { *; }
-keep class com.google.ar.** { *; }
-dontwarn com.google.android.filament.**
-dontwarn io.github.sceneview.**

# "Continue with Google": Credential Manager loads its Play Services provider by
# reflection (rule from the androidx.credentials documentation).
-if class androidx.credentials.CredentialManager
-keep class androidx.credentials.playservices.** {
  *;
}
