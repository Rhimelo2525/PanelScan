# Environment used by `npm test` / `npm run test:watch` / `npm run test:coverage`.
# Copy this to .env.test and point it at a dedicated TEST database - never the
# same database as .env's DATABASE_URL. The test suite truncates every table
# after each test; running it against a real/shared database would destroy data.

NODE_ENV=test
PORT=4001

# Same postgresql:// protocol requirement as the main .env (CockroachDB's
# Prisma provider expects a postgresql://-style connection string).
DATABASE_URL="postgresql://root@localhost:26257/panelscan_test?sslmode=disable"

JWT_SECRET=test-only-secret-do-not-use-in-production-min-32-chars
JWT_EXPIRES_IN=1h
CORS_ORIGIN=*

# Fake values only - the test suite stubs global fetch() for every PayMongo
# call (tests/payment/payment.test.ts), so these are never actually sent to
# PayMongo's real API. They only need to be *present* so payment.service.ts
# doesn't short-circuit with "Payment provider is not configured". The
# webhook secret IS real in the sense that tests compute a matching
# HMAC signature with it to exercise the actual verification code path.
PAYMONGO_SECRET_KEY=sk_test_fake_key_for_testing_only
PAYMONGO_WEBHOOK_SECRET=whsec_fake_test_secret_for_testing_only

# Fake values only - tests/delivery mocks the Lalamove provider, so nothing is
# ever sent to Lalamove. They only need to be *present* so delivery.service.ts
# doesn't answer "Lalamove is not configured" (503), and the webhook route
# exists (it is only mounted with a token; tests post to it with this one).
LALAMOVE_ENV=sandbox
LALAMOVE_API_KEY=pk_test_fake_key_for_testing_only
LALAMOVE_API_SECRET=sk_test_fake_secret_for_testing_only
LALAMOVE_WEBHOOK_TOKEN=fake-webhook-token-for-testing-only

# Fake pickup location for the same tests (a booking needs one configured).
PANELSCAN_WAREHOUSE_NAME=PanelScan Test Warehouse
PANELSCAN_WAREHOUSE_PHONE=+639171234567
PANELSCAN_WAREHOUSE_ADDRESS=1 Test Street
PANELSCAN_WAREHOUSE_BARANGAY=Test Barangay
PANELSCAN_WAREHOUSE_CITY=Test City
PANELSCAN_WAREHOUSE_PROVINCE=Test Province
PANELSCAN_WAREHOUSE_POSTAL=0000
PANELSCAN_WAREHOUSE_LAT=14.8136
PANELSCAN_WAREHOUSE_LNG=121.0450

# Rate limiting env vars (RATE_LIMIT_AUTH_*/RATE_LIMIT_API_*) are
# deliberately NOT set here - rateLimit.middleware.ts's authRateLimiter/
# apiRateLimiter already skip enforcement whenever NODE_ENV=test (this
# file sets NODE_ENV=test above), so the real 500+ integration tests never
# get throttled. The actual 5-per-window/100-per-window behavior is
# verified directly in tests/rateLimit/rateLimit.test.ts using isolated
# middleware instances that bypass this skip on purpose.
