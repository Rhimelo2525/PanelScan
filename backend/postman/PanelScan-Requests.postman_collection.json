{
  "info": {
    "name": "PanelScan API — Request Approval Module",
    "description": "Scoped to what's needed to exercise the Request Approval module end to end: a minimal Auth folder (login an owner and a moderator - customers have no access to this module at all), and the full Requests folder covering create, list/filter, get, edit, approve, reject, cancel, and delete. Follows the same per-module-collection pattern as PanelScan-Chat / PanelScan-Notifications / PanelScan-Feedback / PanelScan-Projects.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "ownerToken", "value": "" },
    { "key": "moderatorToken", "value": "" },
    { "key": "requestId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth (prerequisite)",
      "item": [
        {
          "name": "Login (owner) - requires the seeded OWNER account (or one promoted via Prisma Studio)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@panelscan.com\",\n  \"password\": \"Owner@12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('ownerToken', pm.response.json().data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (moderator) - requires a MODERATOR account already promoted via Prisma Studio or seeded",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"moderator@panelscan.com\",\n  \"password\": \"Moderator@12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('moderatorToken', pm.response.json().data.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Requests",
      "item": [
        {
          "name": "Submit request (MODERATOR)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{moderatorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/requests", "host": ["{{baseUrl}}"], "path": ["requests"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"INVENTORY_RESTOCK\",\n  \"title\": \"Restock cladding panels\",\n  \"description\": \"Down to 3 units in the Quezon City warehouse.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('requestId', pm.response.json().data.request.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List requests - OWNER (every request, filter + search + pagination + sorting)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/requests?status=PENDING&type=INVENTORY_RESTOCK&search=cladding&sortBy=createdAt&sortOrder=desc&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["requests"],
              "query": [
                { "key": "status", "value": "PENDING" },
                { "key": "type", "value": "INVENTORY_RESTOCK" },
                { "key": "search", "value": "cladding" },
                { "key": "sortBy", "value": "createdAt" },
                { "key": "sortOrder", "value": "desc" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "List requests - MODERATOR (own requests only)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{moderatorToken}}" }],
            "url": { "raw": "{{baseUrl}}/requests", "host": ["{{baseUrl}}"], "path": ["requests"] }
          }
        },
        {
          "name": "Get request by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }],
            "url": { "raw": "{{baseUrl}}/requests/{{requestId}}", "host": ["{{baseUrl}}"], "path": ["requests", "{{requestId}}"] }
          }
        },
        {
          "name": "Edit own pending request (MODERATOR)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{moderatorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/requests/{{requestId}}", "host": ["{{baseUrl}}"], "path": ["requests", "{{requestId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Restock cladding + partition panels\"\n}" }
          }
        },
        {
          "name": "Approve request (OWNER)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/requests/{{requestId}}/approve", "host": ["{{baseUrl}}"], "path": ["requests", "{{requestId}}", "approve"] },
            "body": { "mode": "raw", "raw": "{\n  \"reviewNote\": \"Approved - budget confirmed.\"\n}" }
          }
        },
        {
          "name": "Reject request (OWNER)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/requests/{{requestId}}/reject", "host": ["{{baseUrl}}"], "path": ["requests", "{{requestId}}", "reject"] },
            "body": { "mode": "raw", "raw": "{\n  \"reviewNote\": \"Budget not available this quarter.\"\n}" }
          }
        },
        {
          "name": "Cancel own pending request (MODERATOR)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{moderatorToken}}" }],
            "url": { "raw": "{{baseUrl}}/requests/{{requestId}}/cancel", "host": ["{{baseUrl}}"], "path": ["requests", "{{requestId}}", "cancel"] }
          }
        },
        {
          "name": "Delete request (OWNER - any status)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }],
            "url": { "raw": "{{baseUrl}}/requests/{{requestId}}", "host": ["{{baseUrl}}"], "path": ["requests", "{{requestId}}"] }
          }
        }
      ]
    }
  ]
}
