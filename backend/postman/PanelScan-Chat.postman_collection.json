{
  "info": {
    "name": "PanelScan API — Chat Module",
    "description": "First Postman collection committed to this project. Scoped to what's needed to exercise the Chat module end to end: a minimal Auth folder (register/login, to obtain a customer token and a moderator token) plus the full Chat module. Not a full-API collection yet — earlier modules (Category, Product, Inventory, Cart, Order, Payment, Booking, Installer) were documented as prose examples in backend/README.md §7 instead; extend this collection with the same folder pattern as those get their own collections later.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "token", "value": "" },
    { "key": "moderatorToken", "value": "" },
    { "key": "chatId", "value": "" },
    { "key": "messageId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth (prerequisite)",
      "item": [
        {
          "name": "Register (customer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Juan\",\n  \"lastName\": \"Dela Cruz\",\n  \"email\": \"juan.chat@panelscan.test\",\n  \"password\": \"Passw0rd123\",\n  \"phone\": \"+63 912 345 6789\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('token', pm.response.json().data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (customer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan.chat@panelscan.test\",\n  \"password\": \"Passw0rd123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (moderator) - requires a MODERATOR account already promoted via Prisma Studio or seeded",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"moderator@panelscan.com\",\n  \"password\": \"Moderator@12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('moderatorToken', pm.response.json().data.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Create conversation (CUSTOMER)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/chat", "host": ["{{baseUrl}}"], "path": ["chat"] },
            "body": { "mode": "raw", "raw": "{\n  \"subject\": \"Order help\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('chatId', pm.response.json().data.conversation.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List conversations (search + pagination)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/chat?search=order&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["chat"],
              "query": [
                { "key": "search", "value": "order" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get conversation details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/chat/{{chatId}}", "host": ["{{baseUrl}}"], "path": ["chat", "{{chatId}}"] }
          }
        },
        {
          "name": "Send message (CUSTOMER)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/chat/{{chatId}}/messages", "host": ["{{baseUrl}}"], "path": ["chat", "{{chatId}}", "messages"] },
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"Hello, I need help with my order.\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('messageId', pm.response.json().data.message.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Reply (MODERATOR) - auto-joins as participant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{moderatorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/chat/{{chatId}}/messages", "host": ["{{baseUrl}}"], "path": ["chat", "{{chatId}}", "messages"] },
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"Hi Juan, how can I help?\"\n}" }
          }
        },
        {
          "name": "Get messages (newest first)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/messages?sort=desc",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "{{chatId}}", "messages"],
              "query": [{ "key": "sort", "value": "desc" }]
            }
          }
        },
        {
          "name": "Get messages (oldest first)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/messages?sort=asc",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "{{chatId}}", "messages"],
              "query": [{ "key": "sort", "value": "asc" }]
            }
          }
        },
        {
          "name": "Mark message read",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/chat/messages/{{messageId}}/read",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "messages", "{{messageId}}", "read"]
            }
          }
        },
        {
          "name": "Delete own message",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/chat/messages/{{messageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "messages", "{{messageId}}"]
            }
          }
        },
        {
          "name": "Unread count",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/chat/unread/count", "host": ["{{baseUrl}}"], "path": ["chat", "unread", "count"] }
          }
        }
      ]
    }
  ]
}
