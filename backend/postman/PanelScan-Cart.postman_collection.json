{
  "info": {
    "name": "PanelScan API — Cart Module",
    "description": "The authenticated customer's own cart - always 'my cart', never addressed by a cart id in the URL. Every route is CUSTOMER-only. Includes a minimal Auth folder and a Trigger folder that grabs a seeded product id with real Inventory (run `npm run prisma:seed` first). Follows the same per-module-collection pattern as every other PanelScan-*.postman_collection.json file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "token", "value": "" },
    { "key": "productId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth (prerequisite)",
      "item": [
        {
          "name": "Register (customer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Juan\",\n  \"lastName\": \"Dela Cruz\",\n  \"email\": \"juan.cart@panelscan.test\",\n  \"password\": \"Passw0rd123\",\n  \"phone\": \"+63 912 345 6789\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('token', pm.response.json().data.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Trigger (grabs a seeded product id that already has real Inventory)",
      "item": [
        {
          "name": "Get a seeded product id (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?limit=1",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [{ "key": "limit", "value": "1" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var products = pm.response.json().data.products;",
                  "  if (products && products.length > 0) {",
                  "    pm.collectionVariables.set('productId', products[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get cart",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/cart", "host": ["{{baseUrl}}"], "path": ["cart"] }
          },
          "description": "Auto-creates an empty cart the first time it's called for a customer with none yet."
        },
        {
          "name": "Add item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/cart/items", "host": ["{{baseUrl}}"], "path": ["cart", "items"] },
            "body": { "mode": "raw", "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}" }
          },
          "description": "Adding a product already in the cart combines quantities (existing + new), re-validated against available stock as a whole."
        },
        {
          "name": "Update item quantity",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/cart/items/{{productId}}", "host": ["{{baseUrl}}"], "path": ["cart", "items", "{{productId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 3\n}" }
          },
          "description": "Sets the line to an exact quantity (not additive, unlike Add item)."
        },
        {
          "name": "Remove item",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/cart/items/{{productId}}", "host": ["{{baseUrl}}"], "path": ["cart", "items", "{{productId}}"] }
          }
        },
        {
          "name": "Clear cart",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/cart", "host": ["{{baseUrl}}"], "path": ["cart"] }
          },
          "description": "Removes every item but keeps the cart itself."
        }
      ]
    }
  ]
}
