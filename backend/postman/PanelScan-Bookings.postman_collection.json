{
  "info": {
    "name": "PanelScan API — Booking Module",
    "description": "Installation-service booking lifecycle: PENDING -> APPROVED -> (assign installer) -> SCHEDULED -> COMPLETED, or -> CANCELLED. Includes a minimal Auth folder (customer + seeded MODERATOR) and a Trigger folder that creates an installer to assign. Follows the same per-module-collection pattern as every other PanelScan-*.postman_collection.json file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "token", "value": "" },
    { "key": "moderatorToken", "value": "" },
    { "key": "installerId", "value": "" },
    { "key": "bookingId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth (prerequisite)",
      "item": [
        {
          "name": "Register (customer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Juan\",\n  \"lastName\": \"Dela Cruz\",\n  \"email\": \"juan.bookings@panelscan.test\",\n  \"password\": \"Passw0rd123\",\n  \"phone\": \"+63 912 345 6789\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('token', pm.response.json().data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (seeded MODERATOR)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"moderator@panelscan.com\",\n  \"password\": \"Moderator@12345\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('moderatorToken', pm.response.json().data.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Trigger (produces an installer to assign)",
      "item": [
        {
          "name": "Create installer (MODERATOR)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{moderatorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/installers", "host": ["{{baseUrl}}"], "path": ["installers"] },
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Pedro\",\n  \"lastName\": \"Reyes\",\n  \"phone\": \"09171234567\",\n  \"specialty\": \"Wall panel installation\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('installerId', pm.response.json().data.installer.id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create booking (CUSTOMER)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduledDate\": \"2027-02-01\",\n  \"address\": \"123 Rizal Street, Quezon City, Metro Manila, 1100\",\n  \"notes\": \"Second floor unit.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('bookingId', pm.response.json().data.booking.id);",
                  "}"
                ]
              }
            }
          ],
          "description": "scheduledDate must be in the future - 400 otherwise."
        },
        {
          "name": "List my bookings (CUSTOMER)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
          }
        },
        {
          "name": "List all bookings (MODERATOR/OWNER)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{moderatorToken}}" }],
            "url": { "raw": "{{baseUrl}}/bookings/all?status=PENDING", "host": ["{{baseUrl}}"], "path": ["bookings", "all"], "query": [{ "key": "status", "value": "PENDING" }] }
          }
        },
        {
          "name": "Get booking by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}"] }
          }
        },
        {
          "name": "Approve booking (MODERATOR)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{moderatorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}/status", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}", "status"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"APPROVED\"\n}" }
          },
          "description": "MODERATOR-only, not OWNER (OWNER gets 403 here even though it can read every booking via GET /all). A booking must be APPROVED before an installer can be assigned."
        },
        {
          "name": "Assign installer (MODERATOR)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{moderatorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}/assign-installer", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}", "assign-installer"] },
            "body": { "mode": "raw", "raw": "{\n  \"installerId\": \"{{installerId}}\"\n}" }
          },
          "description": "This is the ONLY way a booking reaches SCHEDULED - there is no direct PENDING/APPROVED -> SCHEDULED status transition."
        },
        {
          "name": "Complete booking (MODERATOR)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{moderatorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}/status", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}", "status"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"COMPLETED\"\n}" }
          },
          "description": "Side effect: syncs a Project record for this customer (completes their most recent IN_PROGRESS project, or creates a new COMPLETED one)."
        },
        {
          "name": "Cancel booking (CUSTOMER)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}/cancel", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}", "cancel"] }
          },
          "description": "Only while the booking is still PENDING - 400 otherwise. Run this against a fresh booking (before 'Approve booking' above) to see it succeed."
        }
      ]
    }
  ]
}
