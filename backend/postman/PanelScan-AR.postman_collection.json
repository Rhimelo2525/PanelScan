{
  "info": {
    "name": "PanelScan API — AR Support Module",
    "description": "Scoped to what's needed to exercise the AR Support module end to end: a minimal Auth folder (register a customer, login a moderator), a Setup folder that creates a category + a product with panel width/height/price configured (required for panel estimation), and the full AR folder covering measurement CRUD and the panel estimate calculation. This module is NOT an AR rendering engine - it only stores measurements the Expo app's camera/ARCore/ARKit already produced and estimates panels from them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "token", "value": "" },
    { "key": "moderatorToken", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "measurementId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth (prerequisite)",
      "item": [
        {
          "name": "Register (customer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Juan\",\n  \"lastName\": \"Dela Cruz\",\n  \"email\": \"juan.ar@panelscan.test\",\n  \"password\": \"Passw0rd123\",\n  \"phone\": \"+63 912 345 6789\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('token', pm.response.json().data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (moderator) - requires a MODERATOR account already promoted via Prisma Studio or seeded",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"moderator@panelscan.com\",\n  \"password\": \"Moderator@12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('moderatorToken', pm.response.json().data.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Setup (product with panel dimensions, needed for /estimate)",
      "item": [
        {
          "name": "Create category (MODERATOR)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{moderatorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"AR Demo Panels\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('categoryId', pm.response.json().data.category.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product with width/height/price (MODERATOR)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{moderatorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{categoryId}}\",\n  \"name\": \"Cladding Panel A\",\n  \"sku\": \"AR-DEMO-001\",\n  \"price\": 150,\n  \"width\": 1,\n  \"height\": 2\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('productId', pm.response.json().data.product.id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "AR Measurements",
      "item": [
        {
          "name": "Save a measurement (CUSTOMER)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/ar/measurements", "host": ["{{baseUrl}}"], "path": ["ar", "measurements"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Living room wall\",\n  \"width\": 4,\n  \"height\": 2.5,\n  \"depth\": 0.1,\n  \"unit\": \"m\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('measurementId', pm.response.json().data.measurement.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List measurements (CUSTOMER - own only)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/ar/measurements?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["ar", "measurements"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] }
          }
        },
        {
          "name": "List measurements (MODERATOR - every customer)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{moderatorToken}}" }],
            "url": { "raw": "{{baseUrl}}/ar/measurements", "host": ["{{baseUrl}}"], "path": ["ar", "measurements"] }
          }
        },
        {
          "name": "Get measurement by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/ar/measurements/{{measurementId}}", "host": ["{{baseUrl}}"], "path": ["ar", "measurements", "{{measurementId}}"] }
          }
        },
        {
          "name": "Update own measurement (CUSTOMER)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/ar/measurements/{{measurementId}}", "host": ["{{baseUrl}}"], "path": ["ar", "measurements", "{{measurementId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"width\": 5\n}" }
          }
        },
        {
          "name": "Delete own measurement (CUSTOMER)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/ar/measurements/{{measurementId}}", "host": ["{{baseUrl}}"], "path": ["ar", "measurements", "{{measurementId}}"] }
          }
        }
      ]
    },
    {
      "name": "AR Panel Estimate",
      "item": [
        {
          "name": "Estimate from a saved measurement",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/ar/estimate", "host": ["{{baseUrl}}"], "path": ["ar", "estimate"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"measurementId\": \"{{measurementId}}\"\n}"
            }
          }
        },
        {
          "name": "Estimate from raw width/height (no saved measurement)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/ar/estimate", "host": ["{{baseUrl}}"], "path": ["ar", "estimate"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"width\": 4,\n  \"height\": 3\n}"
            }
          }
        }
      ]
    }
  ]
}
