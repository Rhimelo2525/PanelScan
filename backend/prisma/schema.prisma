// PanelScan - Prisma schema
// Database: CockroachDB
// AR-powered E-commerce and Project Management System for Disenyo Interior Solution

generator client {
  provider = "prisma-client-js"
  // "native" keeps local dev (Windows/macOS/Linux) working as-is;
  // "rhel-openssl-3.0.x" matches Vercel's Node.js serverless runtime;
  // "debian-openssl-3.0.x" matches Docker, Render, Railway, Fly.io, and Debian/Ubuntu VPS.
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider          = "cockroachdb"
  url               = env("DATABASE_URL")
  // CockroachDB Cloud provisions new databases with a default region
  // (survival goal), which auto-creates an internal `crdb_internal_region`
  // enum. `prisma migrate dev`'s auto-created shadow database inherits the
  // same default and conflicts with it (P3006: "crdb_internal_region is a
  // multi-region enum and cannot be modified directly"). Using a dedicated,
  // manually-prepared shadow database (region dropped once, see
  // PROJECT_NOTES.txt) instead of letting Prisma auto-create one avoids
  // this entirely.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ================================================================
// ENUMS
// ================================================================

enum UserRole {
  OWNER
  MODERATOR
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BookingStatus {
  PENDING
  APPROVED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProjectSource {
  MANUAL
  MOBILE_AR_3D
}

enum NotificationType {
  ORDER
  PAYMENT
  BOOKING
  CHAT
  SYSTEM
}

// The spec's enum list covers order/payment/booking/project/notification
// workflows but the Request Approval feature also needs a closed set of
// values for what is being requested and its review outcome. Modeling
// these as free-text strings would allow typos and inconsistent values
// to leak into a business-critical approval workflow, so two small enums
// are added here for the same reason the other five exist.
enum RequestType {
  INVENTORY_RESTOCK
  REFUND
  DISCOUNT_APPROVAL
  PROJECT_BUDGET_CHANGE
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  // A MODERATOR withdrawing their own PENDING request, distinct from an
  // OWNER's REJECTED decision - added for the Request Approval module so
  // "the owner reviewed and rejected this" and "the submitter withdrew
  // this before anyone reviewed it" stay genuinely distinguishable.
  CANCELLED
}

enum DeliveryApprovalStatus {
  NOT_REQUESTED
  PENDING_APPROVAL
  APPROVED
  DECLINED
}

// ================================================================
// USERS
// ================================================================

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  password  String?
  googleId  String?  @unique @map("google_id")
  phone     String?
  // Customer profile details. Both are optional: staff accounts and
  // accounts created before the profile page existed simply leave them null.
  birthdate DateTime? @db.Date
  address   String?
  // Customer profile picture. Only a storage path relative to the uploads
  // root (e.g. "profiles/<userId>/<random>.webp") is kept - never the image
  // bytes, and never a full URL, so moving storage later needs no data
  // migration. The API turns it into an authenticated URL (see
  // modules/profilePicture). The upload timestamp doubles as the cache-buster
  // in that URL; `updatedAt` below remains the general row-changed timestamp.
  profilePicturePath      String?   @map("profile_picture_path")
  profilePictureUpdatedAt DateTime? @map("profile_picture_updated_at")
  role      UserRole @default(CUSTOMER)
  isActive  Boolean  @default(true) @map("is_active")
  // True once the account holder has proven control of `email` (via a
  // one-time emailed code, or because Google verified it). Password
  // recovery is only ever offered to verified emails.
  emailVerified Boolean @default(false) @map("email_verified")
  termsAcceptedAt DateTime? @map("terms_accepted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Customer-side relations
  cart               Cart?
  orders             Order[]
  bookings           Booking[]
  measurements       Measurement[]
  feedbacks          Feedback[]
  projectsAsCustomer Project[]     @relation("CustomerProjects")

  // Staff-side relations
  projectsAsOwner     Project[] @relation("OwnerManagedProjects")
  projectsAsModerator Project[] @relation("ModeratorManagedProjects")
  requestsSubmitted   Request[] @relation("RequestsSubmitted")
  requestsReviewed    Request[] @relation("RequestsReviewed")

  // Shared relations
  chatParticipations ChatParticipant[]
  messages           Message[]
  notifications      Notification[]
  refreshTokens      RefreshToken[]

  // Authentication one-time codes
  passwordResetCodes     PasswordResetCode[]
  emailVerificationCodes EmailVerificationCode[]

  // Audit trail of security/profile-relevant actions this user performed
  activityLogs ActivityLog[]

  @@index([role])
  @@map("users")
}

// ================================================================
// CATALOG: CATEGORY / PRODUCT / PRODUCT IMAGE / INVENTORY
// ================================================================

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([isActive])
  @@map("categories")
}

model Product {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  name        String
  slug        String    @unique
  description String?
  sku         String    @unique
  price       Decimal   @db.Decimal(12, 2)
  // Panel dimensions, used by the AR Measurement / Panel Estimator features
  // to calculate how many units of a product are needed for a scanned area.
  width       Decimal?  @db.Decimal(10, 2)
  height      Decimal?  @db.Decimal(10, 2)
  thickness   Decimal?  @db.Decimal(10, 2)
  unit        String    @default("piece")
  material    String?
  isActive    Boolean   @default(true) @map("is_active")
  isFeatured  Boolean   @default(false) @map("is_featured")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  // Soft delete: OrderItem.product uses onDelete: Restrict, so a product
  // that has ever been ordered can never be hard-deleted. Discontinuing
  // it should set deletedAt instead, preserving historical order data.
  deletedAt   DateTime? @map("deleted_at")

  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String
  altText   String?  @map("alt_text")
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Inventory {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String    @unique @map("product_id") @db.Uuid
  quantity          Int       @default(0)
  reservedQty       Int       @default(0) @map("reserved_qty")
  reorderLevel      Int       @default(10) @map("reorder_level")
  warehouseLocation String?   @map("warehouse_location")
  lastRestockedAt   DateTime? @map("last_restocked_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([quantity])
  @@map("inventory")
}

// ================================================================
// CART
// ================================================================

model Cart {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @unique @map("customer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

// ================================================================
// ORDERS / PAYMENTS / DELIVERY
// ================================================================

model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber     String      @unique @map("order_number")
  customerId      String      @map("customer_id") @db.Uuid
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(12, 2)
  shippingFee     Decimal     @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(12, 2)
  shippingAddress String      @map("shipping_address")
  deliveryLocation Json?      @map("delivery_location")
  moderatorApproved Boolean   @default(false) @map("moderator_approved")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Historical/financial record: a customer can never be hard-deleted
  // while they have orders on file.
  customer  User        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items     OrderItem[]
  payment   Payment?
  delivery  Delivery?
  booking   Booking?
  feedback  Feedback?

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  // Snapshotted at purchase time so historical orders stay accurate even
  // if the product is later renamed, repriced, or discontinued.
  productName String   @map("product_name")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String        @unique @map("order_id") @db.Uuid
  status         PaymentStatus @default(PENDING)
  method         String
  amount         Decimal       @db.Decimal(12, 2)
  transactionRef String?       @unique @map("transaction_ref")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

model Delivery {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String                 @unique @map("order_id") @db.Uuid
  approvalStatus   DeliveryApprovalStatus @default(NOT_REQUESTED) @map("approval_status")
  requestedAt      DateTime?              @map("requested_at")
  approvedAt       DateTime?              @map("approved_at")
  approvedById     String?                @map("approved_by_id") @db.Uuid
  declinedAt       DateTime?              @map("declined_at")
  declineReason    String?                @map("decline_reason")
  courierName      String?                @map("courier_name")
  trackingNumber   String?                @map("tracking_number")
  address          String
  deliveryProvider String?                @default("LALAMOVE") @map("delivery_provider")
  deliveryStatus   String?                @default("NOT_REQUESTED") @map("delivery_status")
  // The real Lalamove order id once booked (POST /v3/orders response) - the
  // permanent cross-system lookup key, so it gets its own indexed column
  // rather than living only inside providerMetadata. Driver/vehicle/tracking
  // snapshots (which change repeatedly over one order's life) stay in
  // providerMetadata instead, matching how this table already handles them.
  lalamoveOrderId  String?                @unique @map("lalamove_order_id")
  providerMetadata Json?                  @map("provider_metadata")
  scheduledDate    DateTime?              @map("scheduled_date")
  deliveredAt      DateTime?              @map("delivered_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPayment DeliveryPayment?

  @@index([approvalStatus])
  @@map("deliveries")
}

// Charges the customer for the Lalamove delivery fee itself, kept entirely
// separate from Payment (which is the product/order subtotal charge only -
// see payment.service.ts). Same shape as Payment on purpose: same status
// enum, same "method" free-text field ("PayMongo" | "Cash"), same
// transactionRef uniqueness - it's the exact same PayMongo Checkout Session
// mechanism, just correlated to a Delivery instead of an Order. Cash never
// touches PayMongo at all: method="Cash" rows go straight to PENDING and
// stay there (rider collects the fee on drop-off; see delivery.service.ts).
model DeliveryPayment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId     String        @unique @map("delivery_id") @db.Uuid
  status         PaymentStatus @default(PENDING)
  method         String
  amount         Decimal       @db.Decimal(12, 2)
  transactionRef String?       @unique @map("transaction_ref")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("delivery_payments")
}

// ================================================================
// INSTALLERS / BOOKINGS / MEASUREMENTS
// ================================================================

model Installer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String?  @unique
  phone     String
  specialty String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bookings Booking[]

  @@index([isActive])
  @@map("installers")
}

model Booking {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId    String        @map("customer_id") @db.Uuid
  orderId       String?       @unique @map("order_id") @db.Uuid
  installerId   String?       @map("installer_id") @db.Uuid
  status        BookingStatus @default(PENDING)
  scheduledDate DateTime      @map("scheduled_date")
  address       String
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  customer  User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order     Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  installer Installer? @relation(fields: [installerId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([installerId])
  @@index([status])
  @@index([scheduledDate])
  @@map("bookings")
}

model Measurement {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  label      String?
  width      Decimal  @db.Decimal(10, 2)
  height     Decimal  @db.Decimal(10, 2)
  depth      Decimal? @db.Decimal(10, 2)
  unit       String   @default("m")
  // Reference photo and raw AR scan/point-cloud data used by the mobile
  // app's AR Measurement + Panel Estimator features.
  imageUrl   String?  @map("image_url")
  arDataUrl  String?  @map("ar_data_url")
  createdAt  DateTime @default(now()) @map("created_at")

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("measurements")
}

// ================================================================
// FEEDBACK
// ================================================================

model Feedback {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  orderId    String?  @unique @map("order_id") @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@map("feedbacks")
}

// ================================================================
// CHAT (CUSTOMER SUPPORT)
// ================================================================

model ChatRoom {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subject   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  participants ChatParticipant[]
  messages     Message[]

  @@map("chat_rooms")
}

// Explicit join table (rather than an implicit Prisma many-to-many)
// because it also needs to carry per-participant state, such as when
// they joined and when they last read the conversation (for unread
// message counts / badges in the UI).
model ChatParticipant {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatRoomId String    @map("chat_room_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  joinedAt   DateTime  @default(now()) @map("joined_at")
  lastReadAt DateTime? @map("last_read_at")

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatRoomId, userId])
  @@index([userId])
  @@map("chat_participants")
}

model Message {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatRoomId String   @map("chat_room_id") @db.Uuid
  senderId   String   @map("sender_id") @db.Uuid
  content    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender   User     @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([chatRoomId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// ================================================================
// NOTIFICATIONS
// ================================================================

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  // Flexible pointer to the related record (e.g. { "orderId": "..." } or
  // { "bookingId": "..." }) so Notification doesn't need a nullable FK
  // column per notification source.
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, isRead])
  @@map("notifications")
}

// ================================================================
// PROJECTS
// ================================================================

model Project {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The client the project is being carried out for. Required for
  // Project Monitoring/Tracking to mean anything in an interior
  // solutions business.
  customerId  String        @map("customer_id") @db.Uuid
  ownerId     String?       @map("owner_id") @db.Uuid
  moderatorId String?       @map("moderator_id") @db.Uuid
  name        String
  description String?
  // Separate from description: description is the OWNER-owned project
  // overview (set at creation, occasionally revised); notes is a
  // MODERATOR-writable running work log added during execution. Keeping
  // them as two columns means neither role's edits can clobber the
  // other's.
  notes       String?
  status      ProjectStatus @default(PENDING)
  source      ProjectSource @default(MANUAL) @map("source")
  externalProjectId String? @map("external_project_id")
  arDataUrl   String?       @map("ar_data_url")
  arMetadata  Json?         @map("ar_metadata")
  threeDModelUrl String?    @map("three_d_model_url")
  threeDMetadata Json?      @map("three_d_metadata")
  startDate   DateTime?     @map("start_date")
  endDate     DateTime?     @map("end_date")
  budget      Decimal?      @db.Decimal(12, 2)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  customer  User  @relation("CustomerProjects", fields: [customerId], references: [id], onDelete: Restrict)
  owner     User? @relation("OwnerManagedProjects", fields: [ownerId], references: [id], onDelete: SetNull)
  moderator User? @relation("ModeratorManagedProjects", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([ownerId])
  @@index([moderatorId])
  @@index([status])
  @@index([source])
  @@index([externalProjectId])
  @@map("projects")
}

// ================================================================
// REQUESTS (OWNER REQUEST APPROVAL)
// ================================================================

model Request {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestedById String        @map("requested_by_id") @db.Uuid
  reviewedById  String?       @map("reviewed_by_id") @db.Uuid
  type          RequestType
  status        RequestStatus @default(PENDING)
  title         String
  description   String?
  reviewNote    String?       @map("review_note")
  reviewedAt    DateTime?     @map("reviewed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  requestedBy User  @relation("RequestsSubmitted", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  User? @relation("RequestsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([requestedById])
  @@index([reviewedById])
  @@index([status])
  @@map("requests")
}

// ================================================================
// REFRESH TOKENS (Refresh Token Authentication)
// ================================================================

// Opaque, cryptographically-random tokens are handed to the client;
// only a deterministic SHA-256 hash of the token is ever stored here
// (never the plaintext), so a leaked database dump can't be replayed
// as a live session. SHA-256 (not bcrypt, unlike User.password) is
// intentional: refresh tokens are already high-entropy random values,
// not human-chosen secrets, so they don't need slow salted hashing -
// and a deterministic hash is required anyway, to look a token up by
// exact match (tokenHash @unique) without scanning/comparing every row.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  // Set on logout or on rotation (refresh issues a new token and revokes
  // the one it was given). Null = still a valid, usable session.
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// One-time 6-digit codes emailed to a customer to recover a forgotten
// password. Only a keyed HMAC of the code is stored (never the plaintext -
// see utils/verificationCode.ts). At most one row per user is live at a
// time (a new request replaces the old one), a row is deleted the moment it
// is redeemed (single use), and `attempts` counts wrong guesses so a code
// can be burned after too many tries.
model PasswordResetCode {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_codes")
}

// Append-only record of who did what and from where, written in the same
// transaction as the change it describes (so the two can never disagree).
// Deliberately generic - `action` is a stable code such as
// "PROFILE_PICTURE_UPDATED" and `metadata` carries action-specific details -
// so later features can log here instead of inventing their own table.
// `userId` is SetNull rather than Cascade: the trail must outlive the
// account it describes.
model ActivityLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  metadata  Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
  @@map("activity_logs")
}

// Same lifecycle as PasswordResetCode, but proves ownership of the
// account's email address (sets User.emailVerified) instead of resetting
// a password. Kept as its own table so the two code types can never be
// redeemed for one another.
model EmailVerificationCode {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_codes")
}
