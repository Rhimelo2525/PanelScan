// PanelScan - Prisma schema (BACKUP / DISASTER-RECOVERY DATABASE)
// Database: Supabase PostgreSQL
//
// This is a structural mirror of schema.prisma (the production CockroachDB
// schema), kept as a SEPARATE schema file so it gets its own datasource,
// its own generated Prisma client, and can never be selected by accident
// by code that just does `import { PrismaClient } from '@prisma/client'`.
//
// This database is NOT read from by the running application. It exists
// only as a target for the one-way sync job (scripts/syncToBackup.ts),
// which copies data FROM CockroachDB (production) TO here. Never the
// other direction.
//
// Keep this file's models in sync with schema.prisma by hand whenever the
// production schema changes - there is no Prisma "import" mechanism, so
// the two schema files are intentionally duplicated rather than shared.

generator backupClient {
  provider      = "prisma-client-js"
  output        = "../src/generated/backup-client"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Pooled connection (Supabase's transaction pooler, port 6543) - what the
  // sync job uses at runtime.
  url      = env("BACKUP_DATABASE_URL")
  // Direct connection (port 5432) - required by `prisma db push` /
  // `prisma migrate`, which cannot run DDL through the transaction pooler.
  directUrl = env("BACKUP_DIRECT_URL")
}

// ================================================================
// ENUMS
// ================================================================

enum UserRole {
  OWNER
  MODERATOR
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BookingStatus {
  PENDING
  APPROVED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProjectSource {
  MANUAL
  MOBILE_AR_3D
}

enum NotificationType {
  ORDER
  PAYMENT
  BOOKING
  CHAT
  SYSTEM
}

enum RequestType {
  INVENTORY_RESTOCK
  REFUND
  DISCOUNT_APPROVAL
  PROJECT_BUDGET_CHANGE
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DeliveryApprovalStatus {
  NOT_REQUESTED
  PENDING_APPROVAL
  APPROVED
  DECLINED
}

// ================================================================
// USERS
// ================================================================

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  password  String?
  googleId  String?  @unique @map("google_id")
  phone     String?
  birthdate DateTime? @db.Date
  address   String?
  profilePicturePath      String?   @map("profile_picture_path")
  profilePictureUpdatedAt DateTime? @map("profile_picture_updated_at")
  role      UserRole @default(CUSTOMER)
  isActive  Boolean  @default(true) @map("is_active")
  emailVerified Boolean @default(false) @map("email_verified")
  termsAcceptedAt DateTime? @map("terms_accepted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Customer-side relations
  cart               Cart?
  orders             Order[]
  bookings           Booking[]
  measurements       Measurement[]
  feedbacks          Feedback[]
  projectsAsCustomer Project[]     @relation("CustomerProjects")

  // Staff-side relations
  projectsAsOwner     Project[] @relation("OwnerManagedProjects")
  projectsAsModerator Project[] @relation("ModeratorManagedProjects")
  requestsSubmitted   Request[] @relation("RequestsSubmitted")
  requestsReviewed    Request[] @relation("RequestsReviewed")

  // Shared relations
  chatParticipations ChatParticipant[]
  messages           Message[]
  notifications      Notification[]
  refreshTokens      RefreshToken[]
  activityLogs       ActivityLog[]

  @@index([role])
  @@map("users")
}

// ================================================================
// CATALOG: CATEGORY / PRODUCT / PRODUCT IMAGE / INVENTORY
// ================================================================

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([isActive])
  @@map("categories")
}

model Product {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  name        String
  slug        String    @unique
  description String?
  sku         String    @unique
  price       Decimal   @db.Decimal(12, 2)
  width       Decimal?  @db.Decimal(10, 2)
  height      Decimal?  @db.Decimal(10, 2)
  thickness   Decimal?  @db.Decimal(10, 2)
  unit        String    @default("piece")
  material    String?
  isActive    Boolean   @default(true) @map("is_active")
  isFeatured  Boolean   @default(false) @map("is_featured")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String
  altText   String?  @map("alt_text")
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Inventory {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String    @unique @map("product_id") @db.Uuid
  quantity          Int       @default(0)
  reservedQty       Int       @default(0) @map("reserved_qty")
  reorderLevel      Int       @default(10) @map("reorder_level")
  warehouseLocation String?   @map("warehouse_location")
  lastRestockedAt   DateTime? @map("last_restocked_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([quantity])
  @@map("inventory")
}

// ================================================================
// CART
// ================================================================

model Cart {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @unique @map("customer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

// ================================================================
// ORDERS / PAYMENTS / DELIVERY
// ================================================================

model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber     String      @unique @map("order_number")
  customerId      String      @map("customer_id") @db.Uuid
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(12, 2)
  shippingFee     Decimal     @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(12, 2)
  shippingAddress String      @map("shipping_address")
  deliveryLocation Json?      @map("delivery_location")
  moderatorApproved Boolean   @default(false) @map("moderator_approved")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  customer  User        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items     OrderItem[]
  payment   Payment?
  delivery  Delivery?
  booking   Booking?
  feedback  Feedback?

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  productName String   @map("product_name")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String        @unique @map("order_id") @db.Uuid
  status         PaymentStatus @default(PENDING)
  method         String
  amount         Decimal       @db.Decimal(12, 2)
  transactionRef String?       @unique @map("transaction_ref")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

model Delivery {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String                 @unique @map("order_id") @db.Uuid
  approvalStatus   DeliveryApprovalStatus @default(NOT_REQUESTED) @map("approval_status")
  requestedAt      DateTime?              @map("requested_at")
  approvedAt       DateTime?              @map("approved_at")
  approvedById     String?                @map("approved_by_id") @db.Uuid
  declinedAt       DateTime?              @map("declined_at")
  declineReason    String?                @map("decline_reason")
  courierName      String?                @map("courier_name")
  trackingNumber   String?                @map("tracking_number")
  address          String
  deliveryProvider String?                @default("LALAMOVE") @map("delivery_provider")
  deliveryStatus   String?                @default("NOT_REQUESTED") @map("delivery_status")
  lalamoveOrderId  String?                @unique @map("lalamove_order_id")
  providerMetadata Json?                  @map("provider_metadata")
  scheduledDate    DateTime?              @map("scheduled_date")
  deliveredAt      DateTime?              @map("delivered_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([approvalStatus])
  @@map("deliveries")
}

// ================================================================
// INSTALLERS / BOOKINGS / MEASUREMENTS
// ================================================================

model Installer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String?  @unique
  phone     String
  specialty String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bookings Booking[]

  @@index([isActive])
  @@map("installers")
}

model Booking {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId    String        @map("customer_id") @db.Uuid
  orderId       String?       @unique @map("order_id") @db.Uuid
  installerId   String?       @map("installer_id") @db.Uuid
  status        BookingStatus @default(PENDING)
  scheduledDate DateTime      @map("scheduled_date")
  address       String
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  customer  User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order     Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  installer Installer? @relation(fields: [installerId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([installerId])
  @@index([status])
  @@index([scheduledDate])
  @@map("bookings")
}

model Measurement {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  label      String?
  width      Decimal  @db.Decimal(10, 2)
  height     Decimal  @db.Decimal(10, 2)
  depth      Decimal? @db.Decimal(10, 2)
  unit       String   @default("m")
  imageUrl   String?  @map("image_url")
  arDataUrl  String?  @map("ar_data_url")
  createdAt  DateTime @default(now()) @map("created_at")

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("measurements")
}

// ================================================================
// FEEDBACK
// ================================================================

model Feedback {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  orderId    String?  @unique @map("order_id") @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@map("feedbacks")
}

// ================================================================
// CHAT (CUSTOMER SUPPORT)
// ================================================================

model ChatRoom {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subject   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  participants ChatParticipant[]
  messages     Message[]

  @@map("chat_rooms")
}

model ChatParticipant {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatRoomId String    @map("chat_room_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  joinedAt   DateTime  @default(now()) @map("joined_at")
  lastReadAt DateTime? @map("last_read_at")

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatRoomId, userId])
  @@index([userId])
  @@map("chat_participants")
}

model Message {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatRoomId String   @map("chat_room_id") @db.Uuid
  senderId   String   @map("sender_id") @db.Uuid
  content    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender   User     @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([chatRoomId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// ================================================================
// NOTIFICATIONS
// ================================================================

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, isRead])
  @@map("notifications")
}

// ================================================================
// PROJECTS
// ================================================================

model Project {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String        @map("customer_id") @db.Uuid
  ownerId     String?       @map("owner_id") @db.Uuid
  moderatorId String?       @map("moderator_id") @db.Uuid
  name        String
  description String?
  notes       String?
  status      ProjectStatus @default(PENDING)
  source      ProjectSource @default(MANUAL) @map("source")
  externalProjectId String? @map("external_project_id")
  arDataUrl   String?       @map("ar_data_url")
  arMetadata  Json?         @map("ar_metadata")
  threeDModelUrl String?    @map("three_d_model_url")
  threeDMetadata Json?      @map("three_d_metadata")
  startDate   DateTime?     @map("start_date")
  endDate     DateTime?     @map("end_date")
  budget      Decimal?      @db.Decimal(12, 2)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  customer  User  @relation("CustomerProjects", fields: [customerId], references: [id], onDelete: Restrict)
  owner     User? @relation("OwnerManagedProjects", fields: [ownerId], references: [id], onDelete: SetNull)
  moderator User? @relation("ModeratorManagedProjects", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([ownerId])
  @@index([moderatorId])
  @@index([status])
  @@index([source])
  @@index([externalProjectId])
  @@map("projects")
}

// ================================================================
// REQUESTS (OWNER REQUEST APPROVAL)
// ================================================================

model Request {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestedById String        @map("requested_by_id") @db.Uuid
  reviewedById  String?       @map("reviewed_by_id") @db.Uuid
  type          RequestType
  status        RequestStatus @default(PENDING)
  title         String
  description   String?
  reviewNote    String?       @map("review_note")
  reviewedAt    DateTime?     @map("reviewed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  requestedBy User  @relation("RequestsSubmitted", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  User? @relation("RequestsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([requestedById])
  @@index([reviewedById])
  @@index([status])
  @@map("requests")
}

// ================================================================
// REFRESH TOKENS (Refresh Token Authentication)
// ================================================================

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model ActivityLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  metadata  Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
  @@map("activity_logs")
}
