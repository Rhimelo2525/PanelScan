# ==============================
# Environment
# ==============================
NODE_ENV=development
PORT=4000

# ==============================
# Database (CockroachDB)
# ==============================
# NOTE: even though the Prisma provider is "cockroachdb", the connection string
# itself must use the postgresql:// (or postgres://) protocol — CockroachDB is
# wire-compatible with Postgres and Prisma's cockroachdb connector expects this.
#
# CockroachDB Cloud example:
# DATABASE_URL="postgresql://<username>:<password>@<host>:26257/<database>?sslmode=verify-full"
# CockroachDB local (cockroach demo / cockroach start-single-node):
# DATABASE_URL="postgresql://root@localhost:26257/panelscan?sslmode=disable"
DATABASE_URL="postgresql://root@localhost:26257/panelscan?sslmode=disable"

# ==============================
# Auth
# ==============================
# Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# ==============================
# CORS
# ==============================
CORS_ORIGIN=http://localhost:3000

# ==============================
# PayMongo (Payment module)
# ==============================
# From your PayMongo Dashboard > Developers > API Keys. Use the sk_test_...
# secret key while developing. Optional at the process level - the server
# still boots without it, but POST /api/payments/create will fail with a
# 500 ("Payment provider is not configured") until it's set.
PAYMONGO_SECRET_KEY=sk_test_replace_with_your_paymongo_secret_key

# From Dashboard > Developers > Webhooks, once you've registered the
# POST /api/payments/webhook endpoint there. Optional, but without it
# incoming webhooks are NOT signature-verified - anyone who finds the URL
# could POST a fake "payment succeeded" event. Never leave this unset in
# production.
PAYMONGO_WEBHOOK_SECRET=whsec_replace_with_your_paymongo_webhook_secret

PAYMONGO_API_URL=https://api.paymongo.com/v1

# Where PayMongo's hosted checkout page redirects the customer after they
# pay / cancel. No frontend exists yet - point these at whatever page you
# want to show meanwhile, or your future web app's routes.
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
PAYMENT_CANCEL_URL=http://localhost:3000/payment/cancel
