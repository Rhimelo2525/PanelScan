# ==============================
# Environment
# ==============================
NODE_ENV=development
PORT=4000

# ==============================
# Database (CockroachDB)
# ==============================
# NOTE: even though the Prisma provider is "cockroachdb", the connection string
# itself must use the postgresql:// (or postgres://) protocol — CockroachDB is
# wire-compatible with Postgres and Prisma's cockroachdb connector expects this.
#
# CockroachDB Cloud example:
# DATABASE_URL="postgresql://<username>:<password>@<host>:26257/<database>?sslmode=verify-full"
# CockroachDB local (cockroach demo / cockroach start-single-node):
# DATABASE_URL="postgresql://root@localhost:26257/panelscan?sslmode=disable"
DATABASE_URL="postgresql://root@localhost:26257/panelscan?sslmode=disable"

# Only needed if you'll run `prisma migrate dev` against a CockroachDB
# Cloud database (not needed for `prisma migrate deploy`/`db push`, and
# never read by the running app - CLI/migration-time only). CockroachDB
# Cloud databases are provisioned with a default region, which conflicts
# with Prisma's auto-created shadow database (see PROJECT_NOTES.txt
# section 3E). Point this at a separate, permanent database you create
# yourself and run `ALTER DATABASE <name> DROP REGION "<region>";` on
# once, instead of letting Prisma auto-create/drop a shadow database.
# SHADOW_DATABASE_URL="postgresql://<username>:<password>@<host>:26257/<db>_shadow?sslmode=verify-full"

# ==============================
# Backup database (Supabase PostgreSQL - disaster recovery only)
# ==============================
# Optional. The running app NEVER reads/writes this - CockroachDB
# (DATABASE_URL above) remains the sole production database. These are
# only used by prisma/schema.backup.prisma (a separate generated Prisma
# client) and scripts/syncToBackup.ts, which one-way copies data FROM
# CockroachDB TO here on a schedule, so a recovery copy exists if
# CockroachDB is ever unavailable. Get both from your Supabase project's
# "Connect" dialog.
#
# Pooled connection (port 6543) - what the sync job uses at runtime. The
# ?pgbouncer=true param is required: it disables Prisma's prepared
# statements, which otherwise fail with "prepared statement already exists"
# under Supabase's transaction-mode pooler.
# BACKUP_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection - required by `prisma db push`/`migrate` only. Use the
# SESSION pooler (same pooler host, port 5432), not db.<project-ref>.supabase.co -
# that direct host is IPv6-only on most Supabase plans and will fail with
# P1001 on an IPv4-only network:
# BACKUP_DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# ==============================
# Auth
# ==============================
# Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# How long an issued refresh token stays valid before it must be re-obtained via
# a fresh login (see POST /api/auth/refresh). Optional - defaults to 7 if unset.
# REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# ==============================
# Google OAuth 2.0 (Customer Sign-In)
# ==============================
# From Google Cloud Console > APIs & Services > Credentials (Web application).
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback (dev)
# Scopes: openid, email, profile
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173


# ==============================
# Email (SMTP) - verification & password-reset codes
# ==============================
# Used to email customers their one-time 6-digit codes (email verification
# and forgot password). Works with any SMTP account: a Gmail app password
# (smtp.gmail.com, port 587), Brevo, SendGrid, Amazon SES, Mailtrap, etc.
# Optional to boot: with SMTP_HOST unset the code is PRINTED TO THE SERVER
# CONSOLE in development (nothing is sent), and production refuses to send
# (503) rather than silently pretend to deliver a security code.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# "true" = implicit TLS (normally port 465); "false" = STARTTLS (587).
# SMTP_SECURE=false
# SMTP_USER=your-account@example.com
# SMTP_PASS=your-app-password
# MAIL_FROM="PanelScan <no-reply@yourdomain.com>"


# ==============================
# CORS
# ==============================
CORS_ORIGIN=http://localhost:3000

# ==============================
# Reverse proxy
# ==============================
# Number of reverse-proxy hops to trust in front of this app, so req.ip and
# rate limiting see the real client instead of the proxy. "1" is correct for
# the common single-proxy-layer setup (Vercel, Render, Railway, Fly.io,
# Heroku, or one nginx in front on a VPS). Set to "false" only if this
# process is directly internet-exposed with no proxy at all. Optional -
# defaults to "1".
# TRUST_PROXY=1

# ==============================
# Storage
# ==============================
# Local disk directory that uploaded product images are written to and
# served from (relative to the process working directory, or an absolute
# path). Optional - defaults to "uploads". Point this at a mounted
# persistent volume path if your host's filesystem isn't durable across
# deploys/restarts. Ignored entirely when BLOB_READ_WRITE_TOKEN (below) is
# set - Blob mode never touches local disk.
# UPLOAD_DIR=uploads

# Vercel Blob - real persistent storage for profile pictures and product
# images on Vercel (local disk, including /tmp, does not survive between
# requests on a serverless host). Auto-populated by Vercel itself once a
# Blob store is attached to the project in the dashboard - never set this
# manually anywhere else. Optional: unset means local-disk storage above,
# which is correct for local dev and any host with a real persistent
# filesystem.
# BLOB_READ_WRITE_TOKEN=

# ==============================
# PayMongo (Payment module)
# ==============================
# From your PayMongo Dashboard > Developers > API Keys. Use the sk_test_...
# secret key while developing. Optional at the process level - the server
# still boots without it, but POST /api/payments/create will fail with a
# 500 ("Payment provider is not configured") until it's set.
PAYMONGO_SECRET_KEY=sk_test_replace_with_your_paymongo_secret_key

# From Dashboard > Developers > Webhooks, once you've registered the
# POST /api/payments/webhook endpoint there. Optional, but without it
# incoming webhooks are NOT signature-verified - anyone who finds the URL
# could POST a fake "payment succeeded" event. Never leave this unset in
# production.
PAYMONGO_WEBHOOK_SECRET=whsec_replace_with_your_paymongo_webhook_secret

PAYMONGO_API_URL=https://api.paymongo.com/v1

# Where PayMongo's hosted checkout page redirects the customer after they
# pay / cancel. No frontend exists yet - point these at whatever page you
# want to show meanwhile, or your future web app's routes.
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
PAYMENT_CANCEL_URL=http://localhost:3000/payment/cancel

# ==============================
# Lalamove (Delivery module) - see backend/README.md "Live Lalamove integration"
# ==============================
# Server-side only credentials for the Lalamove REST API v3. Keep unset or
# set to sandbox during development. NEVER commit real values - these are
# read directly into HMAC-signed requests and can place real, billable
# deliveries when LALAMOVE_ENV=production.
LALAMOVE_ENV=sandbox
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
# A long random secret (e.g. `openssl rand -hex 32`) embedded as a URL path
# segment for POST /api/delivery/webhook/:token - Lalamove's own webhook
# signature scheme isn't publicly documented, so this stands in for it (see
# README). Register the exact deployed URL with Lalamove via PATCH /v3/webhook.
LALAMOVE_WEBHOOK_TOKEN=

# Warehouse / pickup location. ALL of these are required together before a
# quotation can be requested (no fallback defaults - requestQuotation
# refuses clearly, 503, until every field including real GPS coordinates is
# set). Never invent an address or coordinates here; a real Lalamove driver
# gets routed to whatever is configured.
PANELSCAN_WAREHOUSE_NAME="Disenyo Interior Solution Central Warehouse"
PANELSCAN_WAREHOUSE_PHONE=+639170000000
PANELSCAN_WAREHOUSE_ADDRESS="Main Logistics Hub"
PANELSCAN_WAREHOUSE_BARANGAY="Poblacion"
PANELSCAN_WAREHOUSE_CITY="City of San Jose del Monte"
PANELSCAN_WAREHOUSE_PROVINCE="Bulacan"
PANELSCAN_WAREHOUSE_POSTAL="3023"
# Real GPS coordinates of the warehouse - decimal degrees, never a
# city/barangay centroid.
PANELSCAN_WAREHOUSE_LAT=
PANELSCAN_WAREHOUSE_LNG=

# ==============================
# Mapbox Geocoding API v6 (Delivery module) - see backend/README.md
# "Dropoff geocoding"
# ==============================
# Turns a customer's typed checkout address into coordinates for Lalamove.
# Optional - unset behaves exactly as before this was wired in: coordinates
# stay null ("pending"), checkout is unaffected, and staff can still set
# coordinates manually via PATCH /api/delivery/orders/:orderId/coordinates.
# From account.mapbox.com > Tokens (a default public token works, or create
# a secret token scoped to geocoding). A billing-enabled account with a card
# on file is required regardless of volume - PanelScan stores the returned
# coordinates on the order, which Mapbox classifies as "permanent" geocoding
# (see geocoding.service.ts), a track with no free tier.
MAPBOX_ACCESS_TOKEN=

# ==============================
# Rate limiting
# ==============================
# All optional - these are the defaults if omitted. RATE_LIMIT_AUTH_* covers
# POST /api/auth/register + POST /api/auth/login combined (brute-force
# protection); RATE_LIMIT_API_* covers every other /api/* route. /health is
# never rate-limited (it isn't under /api).
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_API_WINDOW_MS=900000
# RATE_LIMIT_API_MAX=100
# Change-password / email-verification / forgot-password endpoints share this
# separate bucket (recovery is a 3-request flow, so it can't live in the
# 5-attempt login bucket above).
# RATE_LIMIT_ACCOUNT_SECURITY_WINDOW_MS=900000
# RATE_LIMIT_ACCOUNT_SECURITY_MAX=10
# Customer profile picture upload/remove (each upload is a full image
# decode + re-encode, so it gets its own modest bucket).
# RATE_LIMIT_UPLOAD_WINDOW_MS=900000
# RATE_LIMIT_UPLOAD_MAX=20
